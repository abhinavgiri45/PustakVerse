# ==============================================================================
# PustakVerse Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Flask Session Security Key
FLASK_SECRET_KEY=replace_with_a_secure_random_hex_key

# ------------------------------------------------------------------------------
# 1. EMAIL & OTP DELIVERY (Google Gmail SMTP)
# ------------------------------------------------------------------------------
# To enable real OTP email delivery to user inboxes:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Under "App name", enter "PustakVerse" and click "Create"
# 3. Copy the 16-character generated password (e.g. "abcd efgh ijkl mnop")
EMAIL_SMTP_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_FROM=your_email@gmail.com

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (GranthMind Study Suite)
# ------------------------------------------------------------------------------
# Get your free Gemini API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Google One-Tap Sign In & Sign Up)
# ------------------------------------------------------------------------------
# Configure at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE D1 DATABASE (100% Free Edge SQL)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_database_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
BASE_URL=https://pustakverse.pages.dev

# ------------------------------------------------------------------------------
# 5. MYSQL / TIDB FALLBACK CONNECTION (Optional)
# ------------------------------------------------------------------------------
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=production

